# Gateway Model Lab global configuration
# Copy to .env, or edit from the Settings tab.
# Provider API keys are NOT stored here; add them in the Providers tab (SQLite).

HOST=127.0.0.1
PORT=8000
DB_PATH=data/health.db
FUNCTIONAL_CONCURRENCY=4
BENCH_CONCURRENCY=2
DEFAULT_TIMEOUT_S=60
BENCH_TOKEN_CAP=150000
LOAD_LEVELS=1,2,4,8
LOAD_REQUESTS_PER_LEVEL=8
CONTEXT_SIZES=1000,8000,32000
REGRESSION_THRESHOLD_PCT=25
COMPARISON_WINDOW=5
COMPARISON_REPEAT=3
SCORE_W_TOKPS=0.30
SCORE_W_TTFT=0.20
SCORE_W_PASS=0.20
SCORE_W_ITL=0.10
SCORE_W_LATENCY=0.10
SCORE_W_COST=0.10