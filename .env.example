# Gateway Model Lab configuration
# Copy to .env and fill in, or configure from the Settings tab in the dashboard.

# Base URL of your gateway (LiteLLM-compatible)
GATEWAY_URL=http://localhost:4000

# Admin key for model listing + metadata (optional; usually the master key)
GATEWAY_ADMIN_KEY=

# Virtual key used for functional tests and benchmarks (the customer path)
GATEWAY_TEST_KEY=

HOST=127.0.0.1
PORT=8000
DB_PATH=data/health.db
FUNCTIONAL_CONCURRENCY=4
BENCH_CONCURRENCY=2
DEFAULT_TIMEOUT_S=60
BENCH_TOKEN_CAP=150000
